rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }

    // Admins are created by hand in the Firebase console (see README).
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /items/{id} {
      function ownsItem() {
        return signedIn() && get(/databases/$(db)/documents/items/$(id)).data.uid == request.auth.uid;
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.type in ['lost', 'found']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.photo.size() < 400000;

      // Owners/admins can edit item details and status. Signed-in users can change their own reaction.
      allow update: if signedIn()
        && request.resource.data.uid == resource.data.uid
        && (
          (
            (resource.data.uid == request.auth.uid || isAdmin())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reactions', 'userReactions', 'type', 'title', 'category', 'place', 'date', 'contact', 'photo', 'verifyQ'])
          )
          || (
            request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'userReactions'])
            && request.resource.data.reactions != resource.data.reactions
            && request.resource.data.userReactions[request.auth.uid] in ['love', 'thanks', null]
            && (
              resource.data.userReactions == null
              || resource.data.userReactions[request.auth.uid] == null
              || resource.data.userReactions[request.auth.uid] != request.resource.data.userReactions[request.auth.uid]
            )
          )
        );

      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 140;
        allow update, delete: if signedIn() && (request.auth.uid == resource.data.uid || isAdmin());
      }

      // Private answer to the verification question: only the poster and admins can see it.
      match /secret/{docId} {
        allow read: if ownsItem() || isAdmin();
        allow create: if signedIn()
          && getAfter(/databases/$(db)/documents/items/$(id)).data.uid == request.auth.uid;
        allow update, delete: if ownsItem() || isAdmin();
      }

      match /claims/{claimId} {
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && !ownsItem();
        allow read: if signedIn() && (resource.data.uid == request.auth.uid || ownsItem() || isAdmin());
        allow list: if signedIn() && (ownsItem() || isAdmin());
        allow update: if (ownsItem() || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        allow delete: if isAdmin();
      }
    }
  }
}
